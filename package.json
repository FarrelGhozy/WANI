{
  "name": "wani",
  "private": false,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "cd api && bun --env-file=../.env --watch run src/index.ts",
    "dev:dash": "cd dashboard && bun run dev",
    "dev:waha": "docker compose -f docker-compose.local.yml up -d waha",
    "dev:waha:logs": "docker compose -f docker-compose.local.yml logs -f waha",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
